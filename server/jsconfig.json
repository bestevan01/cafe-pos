{
  "//": "VS Code/tsc가 서버 폴더를 하나의 프로젝트로 인식하게 한다. types.d.ts(Express Request 확장)를 포함시키는 것이 핵심.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules"]
}
